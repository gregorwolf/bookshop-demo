# https://api.sap.com/api/API_SUPPLIERINVOICE_PROCESS_SRV/overview
# SAP_COM_0057
###
GET {{$dotenv s4hanahost}}/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV/$metadata
Authorization: Basic {{$dotenv s4hana_username}}:{{$dotenv s4hana_password}}
###
GET {{$dotenv s4hanahost}}/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV/
Authorization: Basic {{$dotenv s4hana_username}}:{{$dotenv s4hana_password}}
Accept: application/json
###
GET {{$dotenv s4hanahost}}/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV/A_SupplierInvoice
  ?$inlinecount=allpages
  &$top=10
  #&$filter=CompanyCode eq '{{$dotenv CompanyCode}}' and FiscalYear eq '{{$dotenv FiscalYear}}'
  &$filter=SupplierInvoice eq '5105742420'
  &$orderby=DocumentDate
  #&$select=SupplierInvoice
  &$expand=to_BR_SupplierInvoiceNFDocument,to_SelectedDeliveryNotes,to_SelectedPurchaseOrders,to_SelectedServiceEntrySheets,to_SuplrInvcItemAsset,to_SuplrInvcItemMaterial,to_SuplrInvcItemPurOrdRef,to_SuplrInvoiceAdditionalData,to_SupplierInvoiceItemGLAcct,to_SupplierInvoiceODN,to_SupplierInvoiceTax,to_SupplierInvoiceWhldgTax
Authorization: Basic {{$dotenv s4hana_username}}:{{$dotenv s4hana_password}}
Accept: application/json
